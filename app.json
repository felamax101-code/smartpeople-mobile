{
  "expo": {
    "name": "SmartPipla",
    "slug": "my-app",
    "scheme": "smartpipla",
    "version": "1.1.0",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/maskable_icon_x192.png",
    "ios": {
      "bundleIdentifier": "com.SmartPipla.social",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "84.12.82.233": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "associatedDomains": [
        "applinks:smartpipla.com",
        "applinks:www.smartpipla.com"
      ]
    },
    "android": {
      "package": "com.felix.kilel.smartpipla",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/maskable_icon_x192.png",
        "backgroundColor": "#07112F"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "path": "/post"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "path": "/post"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "path": "/profile"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "pathPrefix": "/profile/"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "path": "/profile"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "pathPrefix": "/profile/"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "path": "/community"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "pathPrefix": "/community/"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "path": "/community"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "pathPrefix": "/community/"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "path": "/sp"
            },
            {
              "scheme": "https",
              "host": "smartpipla.com",
              "pathPrefix": "/sp/"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "path": "/sp"
            },
            {
              "scheme": "https",
              "host": "www.smartpipla.com",
              "pathPrefix": "/sp/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos and videos to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon1.png",
          "backgroundColor": "#020A30",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "f371b562-673c-4b0c-a38c-94b53f036fbb"
      }
    },
    "owner": "ssperts-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f371b562-673c-4b0c-a38c-94b53f036fbb"
    }
  }
}
