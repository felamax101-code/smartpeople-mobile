{
  "expo": {
    "name": "SmartPeople",
    "slug": "my-app",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/icon-192.png",
    "ios": {
      "bundleIdentifier": "com.smartpeople.social",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "84.12.82.233": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "associatedDomains": [
        "applinks:smartpeople.vercel.app"
      ]
    },
    "android": {
      "package": "com.felix.kilel.smartpeople",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#07112F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "smartpeople.vercel.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "smartpeople.vercel.app",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "smartpeople.vercel.app",
              "pathPrefix": "/community"
            },
            {
              "scheme": "https",
              "host": "smartpeople.vercel.app",
              "pathPrefix": "/sp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
       
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "backgroundColor": "#07112F",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f371b562-673c-4b0c-a38c-94b53f036fbb"
      }
    },
    "owner": "ssperts-team",
   "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f371b562-673c-4b0c-a38c-94b53f036fbb"
    }
  }
}
